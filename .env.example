# Required
GOOGLE_API_KEY=

# Required for api/ -- Supabase Postgres connection string
# (Supabase dashboard -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Required for api/ -- secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Optional -- generate_answer_node uses Groq if this is set, Gemini otherwise
GROQ_API_KEY=

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
OLLAMA_MODEL=llama3.2:3b
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=course_materials

DATA_DIR=./data

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
